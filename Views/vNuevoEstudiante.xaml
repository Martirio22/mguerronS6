<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mguerronS6.Views.vNuevoEstudiante"
             Title="vNuevoEstudiante">

    <VerticalStackLayout
        Spacing="20"
        Padding="20">

        <Label
            Text="Agregar nuevo estudiante"
            FontSize="20"
            FontAttributes="Bold"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

        <Grid RowSpacing="15"
              ColumnSpacing="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Text="NOMBRE DEL ESTUDIANTE"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalOptions="Center" />

            <Entry x:Name="txtNombre"
                   Placeholder="Ingresa el nombre"
                   Grid.Row="0"
                   Grid.Column="1" />

            <Label Text="APELLIDO DEL ESTUDIANTE"
                   Grid.Row="1"
                   Grid.Column="0"
                   VerticalOptions="Center" />

            <Entry x:Name="txtApellido"
                   Placeholder="Ingresa el apellido"
                   Grid.Row="1"
                   Grid.Column="1" />

            <Label Text="EDAD DEL ESTUDIANTE"
                   Grid.Row="2"
                   Grid.Column="0"
                   VerticalOptions="Center" />

            <Entry x:Name="txtEdad"
                   Placeholder="Ingresa la edad"
                   Grid.Row="2"
                   Grid.Column="1"
                   Keyboard="Numeric" />

        </Grid>

        <Button x:Name="btnAregar"
                Text="Agregar estudiante"
                Clicked="btnAregar_Clicked" />

    </VerticalStackLayout>
</ContentPage>