<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mguerronS6.Views.vActualizarEliminar"
             Title="vActualizarEliminar">

    <VerticalStackLayout
        Padding="15"
        Spacing="15">

        <Label
            Text="Actualizar - Eliminar Estudiante"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

        <Grid RowSpacing="15"
              ColumnSpacing="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CÓDIGO -->
            <Label Text="CÓDIGO DEL ESTUDIANTE"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalOptions="Center" />

            <Entry x:Name="txtCodigo"
                   Placeholder="Código"
                   Grid.Row="0"
                   Grid.Column="1"
                   Keyboard="Numeric"
                   IsReadOnly="True" />

            <!-- NOMBRE -->
            <Label Text="NOMBRE DEL ESTUDIANTE"
                   Grid.Row="1"
                   Grid.Column="0"
                   VerticalOptions="Center" />

            <Entry x:Name="txtNombre"
                   Placeholder="Ingresa el nombre"
                   Grid.Row="1"
                   Grid.Column="1" />

            <!-- APELLIDO -->
            <Label Text="APELLIDO DEL ESTUDIANTE"
                   Grid.Row="2"
                   Grid.Column="0"
                   VerticalOptions="Center" />

            <Entry x:Name="txtApellido"
                   Placeholder="Ingresa el apellido"
                   Grid.Row="2"
                   Grid.Column="1" />

            <!-- EDAD -->
            <Label Text="EDAD DEL ESTUDIANTE"
                   Grid.Row="3"
                   Grid.Column="0"
                   VerticalOptions="Center" />

            <Entry x:Name="txtEdad"
                   Placeholder="Ingresa la edad"
                   Grid.Row="3"
                   Grid.Column="1"
                   Keyboard="Numeric" />

        </Grid>

        <Button x:Name="btnActualizar"
                Text="Actualizar"
                Clicked="btnActualizar_Clicked" />

        <Button x:Name="btnEliminar"
                Text="Eliminar"
                Clicked="btnEliminar_Clicked" />

    </VerticalStackLayout>
</ContentPage>
